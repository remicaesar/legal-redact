# Allowlist: never send local documents, databases, credentials or reports to a build.
**
!Dockerfile
!requirements.txt
!app.py
!wsgi.py
!classify.py
!web_security.py
!legal_analyzer/
!legal_analyzer/*.py
!blueprints/
!blueprints/*.py
# db/ is listed file by file: re-including the directory itself would bring a
# local legal_documents.db and its backups with it.
!db/*.py
!db/schema.sql
!db/migrations/*.sql
!templates/
!templates/**
!static/
!static/**
!docker/
!docker/*.py
!docker/requirements.txt
!samples/
!samples/documents/
!samples/documents/*.docx
!samples/documents/*.pdf
